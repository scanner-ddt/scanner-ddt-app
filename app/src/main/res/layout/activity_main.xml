<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carta"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Testata -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blu"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scanner DDT"
                    android:textColor="@color/bianco"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSigla"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/timbro"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:rotation="-4"
                    android:text="—"
                    android:textColor="@color/bianco"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Configura le impostazioni per collegare l'app"
                android:textColor="@color/bianco"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvConteggio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/bianco"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:text="DDT in attesa di invio"
                    android:textColor="@color/bianco"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnImpostazioni"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Impostazioni"
                    android:textColor="@color/bianco"
                    app:strokeColor="@color/bianco" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nuovo DDT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuovo DDT"
                android:textColor="@color/inchiostro"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Fotografa prima le pagine del DDT, poi il ticket pesa come ultima pagina."
                android:textColor="@color/grigio"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnScansiona"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:text="Scansiona DDT + ticket"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/boxRisultato"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgTicket"
                    android:layout_width="90dp"
                    android:layout_height="120dp"
                    android:background="@color/blu_chiaro"
                    android:contentDescription="Ticket"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPagine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/inchiostro"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="N. Progressivo del ticket"
                        android:textColor="@color/grigio"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etProgressivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Es. 6619"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:maxLength="20"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOcr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grigio"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/timbro"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:rotation="-2"
                android:text="—"
                android:textColor="@color/rosso"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnCarica"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="Salva e metti in coda"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- In attesa di invio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="In attesa di invio"
                    android:textColor="@color/inchiostro"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAggiorna"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aggiorna" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvVuoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp"
                android:text="Nessun DDT in attesa."
                android:textColor="@color/grigio"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnInviaOra"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Invia subito" />

            <TextView
                android:id="@+id/tvStato"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/grigio"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
